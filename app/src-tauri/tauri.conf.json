{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noritune",
  "version": "0.1.1",
  "identifier": "com.noritune.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Noritune",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "C:/Users/osj00/.cache/karaoke/bin/": "bin/",
      "../../engine/karaoke_engine/": "engine/karaoke_engine/",
      "../../engine/pyproject.toml": "engine/pyproject.toml",
      "../../engine/uv.lock": "engine/uv.lock",
      "../src/licenses/": "licenses/"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Korean"
        ],
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "shortDescription": "내 노래를 반주로 만들어 부르는 PC 노래방"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1MzM5OENCOENCODQyREYKUldUZlFyaU15NWd6ZFJMMTMxcGtjaTR3UjFkS1R1cTZ6a3ZxdXR1ZENrYlo1eGE4b3A2TGFGSjAK",
      "endpoints": [
        "https://github.com/KimHapGeum/noritune-update/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
